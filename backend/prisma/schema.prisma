// Prisma schema for the crowdfunding platform.
// PostgreSQL is used as an indexed, queryable mirror of on-chain state
// plus off-chain metadata (titles, descriptions, images, proofs).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  ACTIVE
  SUCCESSFUL
  FAILED
  CANCELLED
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  RELEASED
  REJECTED
}

enum TransactionType {
  CAMPAIGN_CREATED
  CONTRIBUTION
  MILESTONE_SUBMITTED
  VOTE_CAST
  MILESTONE_APPROVED
  MILESTONE_REJECTED
  FUNDS_RELEASED
  CAMPAIGN_COMPLETED
  CAMPAIGN_STATUS_CHANGED
  REFUND_CLAIMED
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique @db.VarChar(42)
  nonce         String   @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     Campaign[]
  contributions Contribution[]
  votes         Vote[]
  reputation    Reputation?

  @@index([walletAddress])
}

model Campaign {
  id                 String         @id @default(uuid())
  contractCampaignId Int            @unique
  contractAddress    String         @db.VarChar(42)
  chainId            Int
  creationTxHash     String         @db.VarChar(66)

  creatorId   String
  creator     User   @relation(fields: [creatorId], references: [id])

  title       String
  description String
  imageUrl    String?

  goal     Decimal @db.Decimal(38, 0) // stored in wei
  deadline DateTime

  totalRaised   Decimal @default(0) @db.Decimal(38, 0)
  totalReleased Decimal @default(0) @db.Decimal(38, 0)

  status CampaignStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones    Milestone[]
  contributions Contribution[]
  transactions  Transaction[]

  @@index([creatorId])
  @@index([contractCampaignId])
  @@index([status])
}

model Milestone {
  id                 String          @id @default(uuid())
  campaignId         String
  campaign           Campaign        @relation(fields: [campaignId], references: [id])
  contractMilestoneId Int

  title       String?
  description String
  proofUrl    String?

  amount Decimal @db.Decimal(38, 0) // wei allocated to this milestone

  status         MilestoneStatus @default(PENDING)
  submittedAt    DateTime?
  votingDeadline DateTime?
  votesFor       Decimal         @default(0) @db.Decimal(38, 0)
  votesAgainst   Decimal         @default(0) @db.Decimal(38, 0)
  releasedAt     DateTime?
  releaseTxHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes Vote[]

  @@unique([campaignId, contractMilestoneId])
  @@index([campaignId])
  @@index([status])
}

model Contribution {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  amount   Decimal @db.Decimal(38, 0) // wei, this single contribution tx
  txHash   String  @unique @db.VarChar(66)
  blockNumber BigInt
  confirmed   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([userId])
  @@index([txHash])
}

model Vote {
  id          String    @id @default(uuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  support Boolean
  weight  Decimal @db.Decimal(38, 0) // voting weight (= contribution amount at time of vote)
  txHash  String  @db.VarChar(66)

  createdAt DateTime @default(now())

  @@unique([milestoneId, userId])
  @@index([milestoneId])
}

model Transaction {
  id          String          @id @default(uuid())
  campaignId  String?
  campaign    Campaign?       @relation(fields: [campaignId], references: [id])
  type        TransactionType
  txHash      String          @db.VarChar(66)
  blockNumber BigInt
  logIndex    Int
  timestamp   DateTime
  payload     Json

  createdAt DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([campaignId])
  @@index([txHash])
  @@index([type])
}

model Reputation {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  successfulCampaigns    Int     @default(0)
  totalCampaigns         Int     @default(0)
  milestoneCompletionPct Decimal @default(0) @db.Decimal(5, 2)
  totalContributors      Int     @default(0)
  rejectedMilestones     Int     @default(0)
  score                  Decimal @default(0) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Tracks the last block processed by the event indexer so it can resume
// after a restart without missing or double-processing events.
model IndexerState {
  id            Int      @id @default(1)
  lastBlock     BigInt   @default(0)
  updatedAt     DateTime @updatedAt
}
