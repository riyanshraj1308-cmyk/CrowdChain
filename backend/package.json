{
  "name": "blockchain-crowdfunding-backend",
  "version": "1.0.0",
  "description": "Backend for a blockchain-based milestone crowdfunding platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck:hardhat": "tsc -p tsconfig.hardhat.json",
    "hardhat:compile": "hardhat build",
    "hardhat:node": "hardhat node",
    "hardhat:deploy": "hardhat run scripts/deploy.ts --network localhost",
    "hardhat:test": "hardhat test",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "listener": "tsx watch src/blockchain/listeners/eventListener.ts",
    "test:api": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs test/api",
    "test:contract": "hardhat test",
    "test": "npm run test:contract && npm run test:api",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^11.1.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "chai": "^5.3.3",
    "hardhat": "^3.15.0",
    "jest": "^29.7.0",
    "mocha": "^11.8.0",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "qs": "6.16.0",
    "ws": "8.21.0",
    "lodash": "4.18.0",
    "diff": "8.0.3",
    "serialize-javascript": "7.1.1",
    "undici": "6.28.1"
  }
}
