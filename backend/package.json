{
  "name": "blockchain-crowdfunding-backend",
  "version": "1.0.0",
  "description": "Backend for a blockchain-based milestone crowdfunding platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "hardhat:compile": "hardhat build",
    "hardhat:node": "hardhat node",
    "hardhat:deploy": "hardhat run scripts/deploy.js --network localhost",
    "hardhat:test": "hardhat test",
    "seed:demo": "node scripts/seed-demo.js",
    "listener": "node --watch src/blockchain/listeners/eventListener.js",
    "test:api": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs test/api",
    "test:contract": "hardhat test",
    "test": "npm run test:contract && npm run test:api"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "uuid": "^11.1.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "chai": "^5.3.3",
    "hardhat": "^3.15.0",
    "jest": "^29.7.0",
    "mocha": "^11.8.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "ws": "8.21.0",
    "lodash": "4.18.0",
    "diff": "8.0.3",
    "serialize-javascript": "7.1.1",
    "undici": "6.28.1"
  }
}
